#include <winres.h>
#include "ff7vr_buildinfo.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FF7VR_VERSION_NUM
 PRODUCTVERSION FF7VR_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ff7vr loader (xinput1_3 proxy) for FINAL FANTASY VII REMAKE"
            VALUE "FileVersion", FF7VR_VERSION
            VALUE "InternalName", "ff7vr"
            VALUE "OriginalFilename", "xinput1_3.dll"
            VALUE "ProductName", "ff7-remake-vr"
            VALUE "ProductVersion", FF7VR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
